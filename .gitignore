# Build state — cloned into each worktree, so a new worktree starts warm
node_modules/
dist/

# Throwaway — never seeded
tmp/
*.log
.DS_Store

# NOT listed here on purpose: .envrc, local.config.json and notes/ are
# untracked-and-local. `wtx setup` puts them in .git/info/exclude, which is the
# only exclude git reads for a linked worktree.
